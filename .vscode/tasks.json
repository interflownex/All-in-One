{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bootstrap: ambiente dev",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/bootstrap_dev_environment.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "bootstrap: ambiente dev linux",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "./scripts/bootstrap_wsl_dev_environment.sh"
      ],
      "problemMatcher": []
    },
    {
      "label": "cleanup: artifacts",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "scripts/cleanup_artifacts.py"
      ],
      "post_command": "powershell -Command \"$ws = New-Object -ComObject WScript.Shell; $ws.Popup('A limpeza de artefatos do All-in-One foi concluída com sucesso!', 0, 'Cleanup Success', 64)\"",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "test: pytest completo",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "dependsOn": [
        "cleanup: artifacts"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "validate: repository",
      "type": "shell",
      "command": "python3",
      "args": [
        "scripts/validate_repository.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "validate: openapi",
      "type": "shell",
      "command": "python3",
      "args": [
        "scripts/validate_openapi.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "healthcheck: completo linux",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "echo \"[1/3] bootstrap linux\" && ./scripts/bootstrap_wsl_dev_environment.sh && echo \"[2/3] validate repository\" && python3 scripts/validate_repository.py && echo \"[3/3] validate openapi\" && python3 scripts/validate_openapi.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "docker: compose health",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/validate_compose_health.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "gradle: verificar wrapper Valley Android",
      "type": "shell",
      "command": "./gradlew",
      "windows": {
        "command": "gradlew.bat"
      },
      "linux": {
        "command": "./gradlew"
      },
      "osx": {
        "command": "./gradlew"
      },
      "args": [
        "--version",
        "--no-daemon"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/valley-android"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "gradle: parar daemons Valley Android",
      "type": "shell",
      "command": "./gradlew",
      "windows": {
        "command": "gradlew.bat"
      },
      "linux": {
        "command": "./gradlew"
      },
      "osx": {
        "command": "./gradlew"
      },
      "args": [
        "--stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/valley-android"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "gradle: validar Valley Android sem servidor",
      "type": "shell",
      "command": "./gradlew",
      "windows": {
        "command": "gradlew.bat"
      },
      "linux": {
        "command": "./gradlew"
      },
      "osx": {
        "command": "./gradlew"
      },
      "args": [
        "testProductionDebugUnitTest",
        "lintProductionDebug",
        "assembleProductionDebug",
        "--no-daemon",
        "--stacktrace"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/valley-android"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "monitor: gemini watchdog 30min",
      "type": "shell",
      "command": "python3",
      "args": [
        "scripts/gemini_agent_watchdog.py",
        "--interval-minutes",
        "30",
        "--log-file",
        "reports/monitoring/gemini_watchdog.jsonl"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "monitor: gemini watchdog snapshot",
      "type": "shell",
      "command": "python3",
      "args": [
        "scripts/gemini_agent_watchdog.py",
        "--interval-minutes",
        "30",
        "--cycles",
        "1",
        "--log-file",
        "reports/monitoring/gemini_watchdog.jsonl"
      ],
      "problemMatcher": []
    }
  ]
}
