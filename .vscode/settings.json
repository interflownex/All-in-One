{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "powershell.powerShellAdditionalExePaths": [
        "/mnt/c/Users/ereta/.local/bin/pwsh"
    ],
    "cloudcode.gcloudSdkPath": "/usr/bin/gcloud",
    "cloudcode.project": "all-in-one-498012",
    "cloudcode.cloudBuild.enable": true,
    "cloudcode.skaffold.path": "skaffold",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [],
    "python.analysis.typeCheckingMode": "strict",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.fixAll": [
        "source.unusedImports"
    ],
    "ruff.importStrategy": "fromEnvironment",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.autoSave": "afterDelay",
    "files.trimTrailingWhitespace": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit",
        "source.fixAll.ruff": "explicit",
        "source.organizeImports.ruff": "explicit"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "yaml.validate": true,
    "docker.extension.enableComposeLanguageServer": true,
    "docker.lsp.telemetry": "off",
    "rust-analyzer.check.command": "clippy",
    "java.import.gradle.enabled": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.env.windows": {
        "GOOGLE_INTEGRATIONS_ENABLED": "true",
        "GOOGLE_CLOUD_ENABLED": "true",
        "GOOGLE_AI_STUDIO_ENABLED": "true",
        "GOOGLE_CODE_CLI_ENABLED": "true",
        "ALLOYDB_ENABLED": "true",
        "GEMINI_CODE_ASSIST_ENABLED": "true",
        "STITCH_REMOTE_SYNC_ENABLED": "true"
    },
    "terminal.integrated.env.linux": {
        "GOOGLE_INTEGRATIONS_ENABLED": "true",
        "GOOGLE_CLOUD_ENABLED": "true",
        "GOOGLE_AI_STUDIO_ENABLED": "true",
        "GOOGLE_CODE_CLI_ENABLED": "true",
        "ALLOYDB_ENABLED": "true",
        "GEMINI_CODE_ASSIST_ENABLED": "true",
        "STITCH_REMOTE_SYNC_ENABLED": "true"
    },
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell"
        },
        "Git Bash": {
            "path": "C:\\Program Files\\Git\\bin\\bash.exe"
        }
    },
    "geminicodeassist.outlines.automaticOutlineGeneration": true,
    "geminicodeassist.agentYoloMode": false,
    "geminicodeassist.enable": true,
    "workbench.editor.preferHistoryBasedLanguageDetection": true,
    "geminicodeassist.codeLens.enable": false,
    "geminicodeassist.telemetry.enable": false,
    "google.datacloud.enableTelemetry": false,
    "google.cloud.project": "all-in-one-498012",
    "java.configuration.updateBuildConfiguration": "automatic",
    "cloudcode.active-kubeconfig": "Default KubeConfig"
}
