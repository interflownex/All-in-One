{
    "python.defaultInterpreterPath":  "${workspaceFolder}/.venv/bin/python",
    "python.testing.pytestEnabled":  true,
    "python.testing.unittestEnabled":  false,
    "python.testing.pytestArgs":  [

                                  ],
    "python.analysis.typeCheckingMode":  "basic",
    "files.eol":  "\n",
    "files.trimTrailingWhitespace":  true,
    "editor.formatOnSave":  true,
    "yaml.validate":  true,
    "terminal.integrated.defaultProfile.windows":  "PowerShell",
    "terminal.integrated.defaultProfile.linux":  "bash",
    "terminal.integrated.env.windows":  {
                                             "GOOGLE_INTEGRATIONS_ENABLED":  "true",
                                             "GOOGLE_CLOUD_ENABLED":  "true",
                                             "GOOGLE_AI_STUDIO_ENABLED":  "true",
                                             "GOOGLE_CODE_CLI_ENABLED":  "true",
                                             "ALLOYDB_ENABLED":  "true",
                                             "GEMINI_CODE_ASSIST_ENABLED":  "true",
                                             "STITCH_REMOTE_SYNC_ENABLED":  "true"
                                         },
    "terminal.integrated.env.linux":  {
                                           "GOOGLE_INTEGRATIONS_ENABLED":  "true",
                                           "GOOGLE_CLOUD_ENABLED":  "true",
                                           "GOOGLE_AI_STUDIO_ENABLED":  "true",
                                           "GOOGLE_CODE_CLI_ENABLED":  "true",
                                           "ALLOYDB_ENABLED":  "true",
                                           "GEMINI_CODE_ASSIST_ENABLED":  "true",
                                           "STITCH_REMOTE_SYNC_ENABLED":  "true"
                                       },
    "terminal.integrated.profiles.windows":  {
                                                 "PowerShell":  {
                                                                    "source":  "PowerShell"
                                                                },
                                                 "Git Bash":  {
                                                                  "path":  "C:\\Program Files\\Git\\bin\\bash.exe"
                                                              }
                                             },
    "geminicodeassist.outlines.automaticOutlineGeneration":  true,
    "geminicodeassist.agentYoloMode":  false,
    "geminicodeassist.enable":  true,
    "mdb.presetConnections":  [

                              ],
    "workbench.editor.preferHistoryBasedLanguageDetection":  true,
    "geminicodeassist.codeLens.enable":  false,
    "geminicodeassist.telemetry.enable":  false
}
