{
  "database_env": "MONGO_INITDB_DATABASE",
  "default_database": "all_in_one",
  "collections": {
    "ai_memory": {
      "purpose": "Memoria IA consentida e criptografada por usuario.",
      "required": ["user_id", "memory_type", "consent_scope", "created_at"],
      "sensitive_fields": ["content_encrypted"],
      "indexes": [
        { "keys": { "user_id": 1, "created_at": -1 } },
        { "keys": { "retention_until": 1 }, "options": { "expireAfterSeconds": 0 } }
      ]
    },
    "social_videos": {
      "purpose": "Feed social e videos com moderacao e links de comissao.",
      "required": ["user_id", "asset_key", "status", "created_at"],
      "sensitive_fields": ["asset_key", "moderation"],
      "indexes": [
        { "keys": { "user_id": 1, "created_at": -1 } }
      ]
    },
    "influencer_metrics": {
      "purpose": "Metricas agregadas de afiliacao e comissoes por periodo.",
      "required": ["user_id", "period", "created_at"],
      "sensitive_fields": ["commissions_brl"],
      "indexes": [
        { "keys": { "user_id": 1, "period": 1 }, "options": { "unique": true } }
      ]
    },
    "telemetry_logs": {
      "purpose": "Telemetria volumosa com localizacao e retencao temporal.",
      "required": ["user_id", "source", "occurred_at", "payload"],
      "sensitive_fields": ["location", "payload", "device_id"],
      "indexes": [
        { "keys": { "location": "2dsphere" } },
        { "keys": { "user_id": 1, "occurred_at": -1 } },
        { "keys": { "retention_until": 1 }, "options": { "expireAfterSeconds": 0 } }
      ]
    }
  }
}
