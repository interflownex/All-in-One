{
  "version": "2026-07-10",
  "owner": "platform",
  "scope": "outbox-dispatcher",
  "dashboard": {
    "title": "All-in-One - Outbox Dispatcher",
    "uid": "outbox-dispatcher",
    "tags": ["all-in-one", "outbox", "operations"],
    "timezone": "browser",
    "refresh": "30s",
    "time": { "from": "now-6h", "to": "now" },
    "panels": [
      {
        "title": "Pendentes",
        "type": "stat",
        "unit": "short",
        "thresholds": { "warning": 500, "critical": 1000 },
        "targets": [{ "expr": "all_in_one_outbox_pending" }]
      },
      {
        "title": "Prontos para retry",
        "type": "stat",
        "unit": "short",
        "thresholds": { "warning": 100, "critical": 500 },
        "targets": [{ "expr": "all_in_one_outbox_due" }]
      },
      {
        "title": "Publicados",
        "type": "timeseries",
        "unit": "ops",
        "targets": [{ "expr": "increase(all_in_one_outbox_published_total[5m])" }]
      },
      {
        "title": "Falhas retryable",
        "type": "timeseries",
        "unit": "ops",
        "thresholds": { "warning": 1, "critical": 10 },
        "targets": [{ "expr": "increase(all_in_one_outbox_failed_retryable_total[5m])" }]
      },
      {
        "title": "Maior retry observado",
        "type": "stat",
        "unit": "short",
        "thresholds": { "warning": 3, "critical": 5 },
        "targets": [{ "expr": "all_in_one_outbox_max_retry_count" }]
      },
      {
        "title": "Idade do pendente mais antigo",
        "type": "stat",
        "unit": "seconds",
        "thresholds": { "warning": 900, "critical": 1800 },
        "targets": [{ "expr": "all_in_one_outbox_oldest_pending_age_seconds" }]
      },
      {
        "title": "Tendencia do backlog",
        "type": "timeseries",
        "unit": "short",
        "targets": [
          { "expr": "all_in_one_outbox_pending" },
          { "expr": "all_in_one_outbox_due" }
        ]
      },
      {
        "title": "Tendencia de publicacoes e falhas",
        "type": "timeseries",
        "unit": "ops",
        "targets": [
          { "expr": "increase(all_in_one_outbox_published_total[5m])" },
          { "expr": "increase(all_in_one_outbox_failed_retryable_total[5m])" }
        ]
      }
    ]
  }
}
