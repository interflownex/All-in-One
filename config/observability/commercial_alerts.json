{
  "version": "2026-07-05",
  "owner": "business",
  "scope": "marketplace-commercial",
  "metric_source": "kubernetes-prometheus",
  "runbook": "docs/OPERATIONS.md#observabilidade-comercial",
  "labels": {
    "service": "marketplace-commercial",
    "domain": "marketplace",
    "data_classification": "operational"
  },
  "alerts": {
    "MarketplaceOrdersPaidStalled": {
      "severity": "critical",
      "description": "Pedidos existem, mas nao ha pedidos pagos na janela operacional.",
      "expr": "all_in_one_marketplace_orders_total >= 25 and all_in_one_marketplace_orders_paid == 0",
      "for": "15m",
      "response_sla_minutes": 30,
      "evidence": [
        "orders_total",
        "orders_paid",
        "orders_completed",
        "conversion_rate_percent",
        "incident_ticket"
      ]
    },
    "MarketplaceConversionLow": {
      "severity": "medium",
      "description": "Conversao do Marketplace caiu abaixo do minimo esperado.",
      "expr": "all_in_one_marketplace_orders_total >= 50 and all_in_one_marketplace_conversion_rate_percent < 8",
      "for": "30m",
      "response_sla_minutes": 240,
      "evidence": [
        "orders_total",
        "orders_paid",
        "orders_completed",
        "conversion_rate_percent",
        "commercial_dashboard",
        "incident_ticket"
      ]
    },
    "MarketplaceSupportBacklogHigh": {
      "severity": "high",
      "description": "Casos de suporte e disputa em aberto acima do limite operacional.",
      "expr": "all_in_one_marketplace_support_cases_open > 25",
      "for": "30m",
      "response_sla_minutes": 60,
      "evidence": [
        "support_cases_open",
        "support_cases_resolved",
        "support_cases_total",
        "support_trend",
        "incident_ticket"
      ]
    },
    "MarketplaceReputationLow": {
      "severity": "high",
      "description": "Nota media historica e avaliacao abaixo do nivel minimo esperado.",
      "expr": "all_in_one_marketplace_reviews_total >= 20 and all_in_one_marketplace_average_rating < 3.5",
      "for": "30m",
      "response_sla_minutes": 60,
      "evidence": [
        "reviews_total",
        "average_rating",
        "review_trend",
        "commercial_dashboard",
        "incident_ticket"
      ]
    },
    "MarketplaceDisputesUnresolvedHigh": {
      "severity": "high",
      "description": "Casos totais crescem, mas nao ha resolucao suficiente na janela.",
      "expr": "all_in_one_marketplace_support_cases_total >= 10 and all_in_one_marketplace_support_cases_resolved == 0",
      "for": "30m",
      "response_sla_minutes": 120,
      "evidence": [
        "support_cases_total",
        "support_cases_open",
        "support_cases_resolved",
        "resolution_trend",
        "incident_ticket"
      ]
    }
  },
  "notification_policy": {
    "critical": [
      "business_oncall",
      "platform_oncall"
    ],
    "high": [
      "business_oncall"
    ],
    "medium": [
      "platform_oncall"
    ],
    "include_sensitive_payload": false
  }
}
