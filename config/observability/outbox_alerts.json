{
  "version": "2026-07-10",
  "owner": "platform",
  "scope": "outbox-dispatcher",
  "metric_source": "kubernetes-prometheus",
  "runbook": "docs/OPERATIONS.md#outbox",
  "labels": {
    "service": "outbox-dispatcher",
    "domain": "events",
    "data_classification": "operational"
  },
  "alerts": {
    "OutboxBacklogHigh": {
      "severity": "high",
      "description": "Fila de eventos pendentes da outbox acima do limite operacional.",
      "expr": "all_in_one_outbox_pending > 1000",
      "for": "15m",
      "response_sla_minutes": 60,
      "evidence": ["pending_count", "due_count", "dispatcher_logs", "incident_ticket"]
    },
    "OutboxOldestPendingTooOld": {
      "severity": "critical",
      "description": "Evento pendente mais antigo da outbox excedeu o SLA operacional.",
      "expr": "all_in_one_outbox_oldest_pending_age_seconds > 1800",
      "for": "10m",
      "response_sla_minutes": 30,
      "evidence": [
        "oldest_pending_age_seconds",
        "event_selector_hash",
        "dispatcher_logs",
        "incident_ticket"
      ]
    },
    "OutboxRetryableFailuresHigh": {
      "severity": "high",
      "description": "Falhas retryable de publicacao da outbox cresceram na janela recente.",
      "expr": "increase(all_in_one_outbox_failed_retryable_total[15m]) > 10",
      "for": "10m",
      "response_sla_minutes": 60,
      "evidence": [
        "failed_retryable_delta",
        "last_error_type",
        "rabbitmq_status",
        "incident_ticket"
      ]
    },
    "OutboxDueWithoutDeliveries": {
      "severity": "medium",
      "description": "Ha eventos prontos para entrega, mas nenhuma publicacao recente confirmada.",
      "expr": "all_in_one_outbox_due > 0 and increase(all_in_one_outbox_published_total[15m]) == 0",
      "for": "15m",
      "response_sla_minutes": 120,
      "evidence": ["due_count", "published_delta", "dispatcher_pod_status", "incident_ticket"]
    }
  },
  "notification_policy": {
    "critical": ["platform_oncall"],
    "high": ["platform_oncall"],
    "medium": ["platform_oncall"],
    "include_sensitive_payload": false
  }
}
