{
  "version": "1.0.0",
  "status": "proposed",
  "issue": 204,
  "default_effect": "deny",
  "session_context": {
    "tenant_id": {
      "setting": "app.tenant_id",
      "required": true,
      "format": "uuid"
    },
    "subject_id": {
      "setting": "app.subject_id",
      "required": true,
      "format": "uuid"
    },
    "subject_type": {
      "setting": "app.subject_type",
      "required": true,
      "allowed": ["user", "service", "support", "auditor"]
    },
    "purpose": {
      "setting": "app.processing_purpose",
      "required": true,
      "allowed": ["service_delivery", "security", "compliance", "support", "data_subject_request"]
    },
    "request_id": {
      "setting": "app.request_id",
      "required": true,
      "format": "uuid"
    }
  },
  "principles": [
    "tenant_isolation",
    "least_privilege",
    "purpose_limitation",
    "relationship_based_access",
    "auditable_override",
    "fail_closed"
  ],
  "privileged_access": {
    "bypass_rls_allowed": false,
    "support_requires_ticket": true,
    "support_requires_expiry": true,
    "break_glass_requires_incident": true,
    "break_glass_max_minutes": 60,
    "audit_event_required": true
  },
  "database_contract": {
    "application_roles_must_not_own_tables": true,
    "force_row_level_security": true,
    "policies_require_tenant_id": true,
    "missing_context_denies_access": true,
    "cross_tenant_access_denied": true,
    "service_access_requires_declared_purpose": true
  },
  "non_goals": [
    "production_activation",
    "legal_validation",
    "global_bypass_role",
    "implicit_superuser_access"
  ]
}
