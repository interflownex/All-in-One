{
  "version": "2026-07-19",
  "enabled": true,
  "release_stage": "preview",
  "starter_pack": {
    "repository": "https://github.com/gemini-cli-extensions/data-agent-kit-starter-pack",
    "version": "0.6.1",
    "codex_marketplace": "data-agent-kit-starter-pack-marketplace",
    "codex_plugin": "dak",
    "vscode_extension": "GoogleCloudTools.datacloud"
  },
  "defaults": {
    "project_environment_variable": "GOOGLE_CLOUD_PROJECT",
    "project_id": "all-in-one-498012",
    "region_environment_variable": "GCP_REGION",
    "region": "southamerica-east1",
    "bigquery_location_environment_variable": "BIGQUERY_LOCATION",
    "bigquery_location": "southamerica-east1"
  },
  "supported_agents": [
    "codex",
    "gemini_cli",
    "gemini_code_assist",
    "antigravity"
  ],
  "required_apis": [
    "aiplatform.googleapis.com",
    "alloydb.googleapis.com",
    "biglake.googleapis.com",
    "bigquery.googleapis.com",
    "composer.googleapis.com",
    "dataplex.googleapis.com",
    "dataproc.googleapis.com",
    "dataprocrm.googleapis.com",
    "spanner.googleapis.com",
    "sqladmin.googleapis.com",
    "storage.googleapis.com"
  ],
  "security": {
    "credentials_outside_git": true,
    "require_application_default_credentials": true,
    "least_privilege": true,
    "allow_automatic_iam_changes": false,
    "allow_automatic_billing_changes": false,
    "allow_destructive_data_operations": false
  }
}
