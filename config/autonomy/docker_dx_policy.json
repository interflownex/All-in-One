{
  "version": 1,
  "name": "docker_dx",
  "description": "Politica persistente para Developer Experience Docker no workspace all-in-one.",
  "compose_file": "infra/docker/docker-compose.yml",
  "env_file": ".env.docker-dx",
  "runtime": {
    "preferred_engine": "wsl_docker_engine",
    "allow_docker_desktop": true,
    "require_compose_plugin": true,
    "require_buildx_plugin": true,
    "forbid_world_writable_socket": true
  },
  "build": {
    "docker_buildkit": "1",
    "compose_docker_cli_build": "1",
    "progress": "plain",
    "context_hygiene": {
      "required_dockerignore": true,
      "required_exclusions": [
        ".git",
        ".venv",
        ".pytest_cache",
        ".pytest_tmp",
        "node_modules",
        ".env",
        ".env.*",
        "tests",
        "apps",
        "docs",
        "reports"
      ]
    }
  },
  "compose": {
    "project_name": "all-in-one-dx",
    "health_gate": "python3 scripts/validate_compose_health.py --env-file .env.docker-dx --project-name all-in-one-dx --require-free-ports --down-after --command-timeout-seconds 900 --timeout-seconds 600 --probe-timeout-seconds 1",
    "up": "docker compose --env-file .env.docker-dx -f infra/docker/docker-compose.yml up -d --build",
    "down": "docker compose --env-file .env.docker-dx -f infra/docker/docker-compose.yml down --remove-orphans",
    "logs": "docker compose --env-file .env.docker-dx -f infra/docker/docker-compose.yml logs --tail 120"
  },
  "environment_defaults": {
    "COMPOSE_PROJECT_NAME": "all-in-one-dx",
    "DOCKER_BUILDKIT": "1",
    "COMPOSE_DOCKER_CLI_BUILD": "1",
    "BUILDKIT_PROGRESS": "plain",
    "GOOGLE_INTEGRATIONS_ENABLED": "false",
    "GOOGLE_CLOUD_ENABLED": "false",
    "GOOGLE_AI_STUDIO_ENABLED": "false",
    "GOOGLE_CODE_CLI_ENABLED": "false",
    "ALLOYDB_ENABLED": "false",
    "STITCH_REMOTE_SYNC_ENABLED": "false",
    "GEMINI_CODE_ASSIST_ENABLED": "true"
  },
  "mcp": {
    "docker_gateway_entry_name": "docker",
    "enable_when_docker_mcp_exists": true,
    "fallback_when_unavailable": "keep_runtime_without_docker_mcp"
  },
  "validation": {
    "static_commands": [
      "python3 scripts/configure_docker_dx.py --check",
      "python3 scripts/validate_repository.py",
      "PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 ./.venv/bin/python -m pytest -q tests/test_docker_dx_policy.py tests/test_docker_context_hygiene.py tests/test_compose_health_gate.py"
    ],
    "live_commands": [
      "docker version",
      "docker compose version",
      "docker buildx version",
      "python3 scripts/validate_compose_health.py --env-file .env.docker-dx --project-name all-in-one-dx --require-free-ports --down-after --command-timeout-seconds 900 --timeout-seconds 600 --probe-timeout-seconds 1"
    ]
  }
}
