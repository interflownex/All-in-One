{
  "schema_version": "1.0.0",
  "project": "All in One + Valley",
  "repository": "interflownex/All-in-One",
  "status": "mandatory",
  "effective_from": "2026-08-04",
  "required_capabilities": {
    "github": {
      "required": true,
      "native_in_task": true,
      "must_remain_enabled": true,
      "required_checks": [
        "repository",
        "issues",
        "pull_requests",
        "commits",
        "checks",
        "workflow_runs",
        "dependabot",
        "merge_policy"
      ]
    },
    "cloudflare": {
      "required_for_cloudflare_scope": true,
      "direct_connector_preferred": true,
      "fallback": "wrangler_or_official_api_via_secret_manager",
      "must_validate": [
        "production_branch",
        "latest_deployment",
        "custom_domains",
        "tls",
        "redirects",
        "security_headers",
        "rollback"
      ]
    },
    "mcp_apps": {
      "required_for_mcp_scope": true,
      "source_of_truth": "services/aio-mcp-gateway",
      "transport": "streamable_http",
      "protocol_path": "/mcp",
      "health_path": "/health",
      "production_gates": [
        "oauth_oidc",
        "tool_scopes",
        "rate_limit",
        "redacted_logs",
        "pip_audit",
        "trivy",
        "sbom_provenance",
        "external_secrets",
        "https_dns_certificate",
        "rollback",
        "gemini_spark_validation"
      ]
    }
  },
  "merge_policy": {
    "direct_push_to_main": false,
    "allowed_method": "squash",
    "expected_head_sha_required": true,
    "all_required_gates_same_sha": true,
    "auto_merge": false,
    "merge_commit": false,
    "rebase_merge": false
  },
  "dependency_policy": {
    "dependabot_required": true,
    "security_alerts_required": true,
    "major_updates_require_compatibility_validation": true,
    "no_red_markers_before_merge": true
  },
  "failure_policy": {
    "missing_required_connector": "mark_incomplete_and_record_blocker",
    "red_cancelled_missing_pending_gate": "block_merge",
    "secret_detected": "block_and_rotate",
    "external_billing_or_dns_blocker": "do_not_bypass"
  }
}
