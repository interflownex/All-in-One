{
  "version": 2,
  "enabled": true,
  "channel": "telegram",
  "required_secrets": [
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_CHAT_ID"
  ],
  "credentials_outside_git": true,
  "delivery_script": "scripts/send_ready_artifact_to_telegram.py",
  "activity_executor": "scripts/telegram_activity_reporter.py",
  "pending_report_executor": "scripts/telegram_activity_reporter.py",
  "implementation_status": "initial_cli_versioned_pending_ci_and_schedule",
  "network": {
    "timeout_seconds": 20,
    "max_retries": 3,
    "backoff_seconds": [1, 2, 4]
  },
  "activity_notifications": {
    "enabled": true,
    "channel": "telegram",
    "events": [
      "activity_started",
      "activity_completed"
    ],
    "start_payload": {
      "required_fields": [
        "activity_name",
        "technical_description",
        "estimated_completion_time",
        "reported_difficulty",
        "initial_progress_percent"
      ],
      "defaults": {
        "initial_progress_percent": 0
      }
    },
    "completion_payload": {
      "required_fields": [
        "activity_name",
        "status",
        "completion_percent",
        "failure_detected",
        "failure_summary",
        "failure_cause",
        "resolution_action",
        "resolvable",
        "pending_items",
        "next_steps"
      ],
      "status_values": [
        "success",
        "partial_success",
        "failed"
      ]
    }
  },
  "developer_pending_reports": {
    "enabled": true,
    "channel": "telegram",
    "frequency_per_day": 4,
    "schedule_timezone": "America/Sao_Paulo",
    "schedule_status": "pending_ci_and_secret_configuration",
    "required_fields": [
      "report_index",
      "generated_at",
      "open_pendings",
      "blocked_pendings",
      "risk_summary",
      "eta_summary"
    ],
    "auto_include_from_activity_updates": true
  },
  "targets": {
    "web": {
      "application": "apps/all-in-one",
      "ready_when": [
        "build_succeeded",
        "deployment_succeeded",
        "public_url_available",
        "web_identity_verified"
      ],
      "delivery": "public_url_and_version",
      "identity_marker": "<title>All-in-One — Ecossistema Digital</title>",
      "workflow": ".github/workflows/cloudflare-pages.yml"
    },
    "app": {
      "application": "apps/valley-android",
      "ready_when": [
        "build_succeeded",
        "release_validation_succeeded",
        "installable_artifact_available"
      ],
      "delivery": "installable_artifact_and_version"
    }
  },
  "validation": {
    "dry_run_required_before_real_send": true,
    "tests": [
      "tests/test_telegram_activity_reporter.py"
    ],
    "forbid_secret_logging": true,
    "max_message_length": 3900,
    "report_index_range": [1, 4]
  },
  "rules": [
    "Enviar via Telegram no início e no fim de cada atividade gerada pela IA.",
    "No início, informar nome, descrição técnica, dificuldade, tempo estimado e progresso inicial.",
    "No encerramento, informar status, percentual, falhas, causa, ação, pendências e próximos passos.",
    "Incluir automaticamente as pendências detectadas nas atualizações do desenvolvedor.",
    "Encaminhar quatro relatórios por dia somente após CI e secrets legítimos estarem configurados.",
    "Executar dry-run antes de envio real.",
    "Não declarar prontidão com build parcial, deploy incompleto ou artefato não verificado.",
    "Nunca versionar token do bot, chat ID ou outras credenciais do Telegram.",
    "Nunca imprimir token ou chat ID em logs, erros ou relatórios.",
    "Falhas de rede devem usar retry limitado e não criar loop infinito."
  ]
}
