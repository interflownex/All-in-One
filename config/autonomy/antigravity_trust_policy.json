{
  "version": 1,
  "name": "antigravity_trust",
  "description": "Politica local-first para workspace confiavel do Antigravity e MCPs essenciais.",
  "scope": "all-in-one",
  "trusted_workspaces": {
    "wsl": "/home/eretazan/.codex/worktrees/1781507772-23398/all-in-one",
    "windows": "C:\\Users\\ereta\\.codex\\worktrees\\all-in-one",
    "windows_unc": "\\\\wsl.localhost\\Ubuntu\\home\\eretazan\\.codex\\worktrees\\1781507772-23398\\all-in-one"
  },
  "config_targets": [
    "/mnt/c/Users/ereta/.gemini/antigravity/mcp_config.json",
    "/home/eretazan/.gemini/antigravity/mcp_config.json"
  ],
  "essential_mcp_servers": [
    "filesystem-all-in-one",
    "context7",
    "cloudflare-docs",
    "cloudflare-api",
    "docker",
    "stitch"
  ],
  "disabled_mcp_servers": [
    "arize-tracing-assistant",
    "chrome-devtools-mcp",
    "cloudrun",
    "datacloud_alloydb_remote",
    "datacloud_bigquery_remote",
    "datacloud_cloud-sql_remote",
    "datacloud_dataproc_remote",
    "datacloud_knowledge_catalog_remote",
    "datacloud_spanner_remote",
    "figma",
    "github-mcp-server",
    "gitlab-orbit",
    "gke-oss",
    "gopls-mcp-server",
    "linear",
    "memory",
    "notebooks",
    "playwright",
    "postgres",
    "prisma-mcp-server",
    "sequential-thinking",
    "visualization"
  ],
  "docker_mcp": {
    "profile": "all_in_one_local",
    "command": "docker",
    "args": [
      "mcp",
      "gateway",
      "run",
      "--profile",
      "all_in_one_local"
    ]
  },
  "secret_environment_variables": [
    "CLOUDFLARE_API_TOKEN",
    "STITCH_API_KEY",
    "STITCH_ACCESS_TOKEN"
  ],
  "rules": [
    "Antigravity deve abrir o workspace WSL confiavel do All-in-One.",
    "Antigravity nao deve manter MCPs pagos, redundantes ou sem credencial legitima por padrao.",
    "Cloudflare MCP API deve depender de CLOUDFLARE_API_TOKEN no ambiente, nunca de bearer literal.",
    "Stitch permanece ativo por variavel de ambiente e sem segredo no arquivo versionado ou local.",
    "Docker MCP deve usar o perfil local all_in_one_local.",
    "Backups locais do mcp_config.json real podem existir fora do Git."
  ],
  "validation": {
    "command": "python3 scripts/configure_antigravity_trust.py --check",
    "apply_command": "python3 scripts/configure_antigravity_trust.py --apply"
  }
}
