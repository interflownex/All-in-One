{
  "version": "2026-06-06",
  "enabled": true,
  "project_environment_variable": "GOOGLE_CLOUD_PROJECT",
  "default_region": "southamerica-east1",
  "default_zone": "southamerica-east1-a",
  "authoritative_project": "all-in-one-498012",
  "authoritative_inventory": "config/cloud/google_cloud_inventory.json",
  "authority_mode": "remote_state_is_authoritative",
  "required_apis": [
    "aiplatform.googleapis.com",
    "alloydb.googleapis.com",
    "biglake.googleapis.com",
    "bigquery.googleapis.com",
    "composer.googleapis.com",
    "apigee.googleapis.com",
    "apihub.googleapis.com",
    "artifactregistry.googleapis.com",
    "cloudbuild.googleapis.com",
    "cloudkms.googleapis.com",
    "cloudresourcemanager.googleapis.com",
    "compute.googleapis.com",
    "dataplex.googleapis.com",
    "dataproc.googleapis.com",
    "dataprocrm.googleapis.com",
    "container.googleapis.com",
    "iam.googleapis.com",
    "run.googleapis.com",
    "secretmanager.googleapis.com",
    "serviceusage.googleapis.com",
    "spanner.googleapis.com",
    "storage.googleapis.com",
    "sqladmin.googleapis.com"
  ],
  "restorable_resources": ["compute_instances_terminated", "cloud_sql_instances_never"],
  "safety": {
    "requires_authenticated_gcloud": true,
    "requires_explicit_project": true,
    "requires_import_before_change": true,
    "preserve_existing_remote_resources": true,
    "allow_delete": false,
    "allow_billing_change": false,
    "allow_policy_bypass": false,
    "secrets_outside_git": true
  }
}
