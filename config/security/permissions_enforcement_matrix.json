{
  "version": "2026-07-15",
  "scope": "permissions_rbac_abac_runtime_enforcement",
  "module": "permissions",
  "deny_by_default": true,
  "read_roles": [
    "owner",
    "administrator",
    "compliance_officer",
    "data_protection_officer",
    "auditor"
  ],
  "write_roles": [
    "owner",
    "administrator",
    "compliance_officer"
  ],
  "mfa_required_for_resources": [
    "approval_limits"
  ],
  "resources": {
    "roles": {
      "read": "read_roles",
      "write": "write_roles",
      "mfa_required_for_write": false
    },
    "permissions": {
      "read": "read_roles",
      "write": "write_roles",
      "mfa_required_for_write": false
    },
    "user_roles": {
      "read": "read_roles",
      "write": "write_roles",
      "mfa_required_for_write": false
    },
    "access_policies": {
      "read": "read_roles",
      "write": "write_roles",
      "mfa_required_for_write": false
    },
    "approval_limits": {
      "read": "read_roles",
      "write": "write_roles",
      "mfa_required_for_write": true
    }
  },
  "domain_consumers": {
    "runtime_entrypoints": [
      "modules.shared.runtime._expose",
      "modules.shared.domain_rules.can_read_sensitive"
    ],
    "source_review": "config/security/sensitive_permissions_review.json",
    "modules": {
      "identity": {
        "runtime_rule": "SENSITIVE_ROLES",
        "sensitive_resources": ["users", "kyc_records", "documents", "biometrics", "identity_verifications", "consent_records"]
      },
      "finance": {
        "runtime_rule": "SENSITIVE_ROLES",
        "sensitive_resources": ["wallets", "ledger_entries", "escrows", "splits", "invoices", "valley_gold_ledger_entries"]
      },
      "jobs": {
        "runtime_rule": "RECRUITER_ROLES",
        "sensitive_resources": ["resumes", "employment_records", "resume_documents", "applications", "resume_access_logs"]
      },
      "document": {
        "runtime_rule": "SENSITIVE_ROLES",
        "sensitive_resources": ["documents", "versions"]
      },
      "health": {
        "runtime_rule": "MEDICAL_ROLES",
        "sensitive_resources": ["patients", "appointments", "medical_records", "prescriptions", "beds"]
      },
      "hr": {
        "runtime_rule": "SENSITIVE_ROLES",
        "sensitive_resources": ["employees", "payroll_runs", "occupational_records"]
      }
    }
  },
  "negative_tests": [
    "common_user_cannot_create_role",
    "common_user_cannot_list_roles",
    "auditor_cannot_create_role",
    "administrator_without_mfa_cannot_create_approval_limit",
    "third_party_without_sensitive_role_cannot_read_finance_wallet",
    "auditor_without_medical_context_cannot_read_patient_record"
  ],
  "positive_tests": [
    "administrator_can_create_role",
    "auditor_can_list_roles",
    "administrator_with_mfa_can_create_approval_limit",
    "auditor_can_read_finance_wallet_with_runtime_sensitive_role",
    "doctor_can_read_patient_record_with_runtime_medical_role"
  ],
  "runtime_entrypoint": "modules.shared.runtime._authorize_permissions_operation"
}
