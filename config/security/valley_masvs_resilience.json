{
  "version": "2026-07-20",
  "profile": "MASVS-R",
  "enforcement": "release-only",
  "controls": {
    "MASVS-RESILIENCE-1": ["root-artifacts", "test-keys", "play-integrity-device-verdict"],
    "MASVS-RESILIENCE-2": [
      "play-app-signing-certificate-sha256",
      "play-integrity-app-verdict",
      "r8-minification"
    ],
    "MASVS-RESILIENCE-3": ["r8-obfuscation", "resource-shrinking", "release-symbol-removal"],
    "MASVS-RESILIENCE-4": ["debugger", "tracer-pid", "frida-xposed-substrate-zygisk-maps"]
  },
  "response": {
    "local": "block-sensitive-flows",
    "authoritative": "server-side-play-integrity-tiered-enforcement",
    "telemetry": "signal-category-only",
    "never_log": ["process_maps", "installed_packages", "tokens", "user_identifiers"]
  },
  "limitations": [
    "client-side checks are defense in depth and can be bypassed",
    "debug builds intentionally bypass local enforcement",
    "server-side Play Integrity verdict validation is mandatory before production"
  ]
}
