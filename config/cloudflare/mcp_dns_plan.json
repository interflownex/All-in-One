{
  "schema_version": "1.0.0",
  "updated_at": "2026-08-04T03:08:00-03:00",
  "zone_name": "brasildesconto.com.br",
  "deployment_model": "single_gateway_with_dns_aliases",
  "canonical": {
    "environment": "production",
    "hostname": "mcp.brasildesconto.com.br",
    "record_type": "CNAME",
    "target_env_var": "MCP_PRODUCTION_DNS_TARGET",
    "proxied": true,
    "ttl": 1,
    "mcp_url": "https://mcp.brasildesconto.com.br/mcp",
    "health_url": "https://mcp.brasildesconto.com.br/health"
  },
  "environments": [
    {
      "environment": "staging",
      "hostname": "mcp-staging.brasildesconto.com.br",
      "record_type": "CNAME",
      "target_env_var": "MCP_STAGING_DNS_TARGET",
      "proxied": true,
      "ttl": 1
    },
    {
      "environment": "preview",
      "hostname": "mcp-preview.brasildesconto.com.br",
      "record_type": "CNAME",
      "target_env_var": "MCP_PREVIEW_DNS_TARGET",
      "proxied": true,
      "ttl": 1
    }
  ],
  "aliases": [
    {
      "environment": "production",
      "hostname": "mcp-valley.brasildesconto.com.br",
      "record_type": "CNAME",
      "target": "mcp.brasildesconto.com.br",
      "proxied": true,
      "ttl": 1,
      "scope": "aio:valley:read"
    },
    {
      "environment": "production",
      "hostname": "mcp-rider.brasildesconto.com.br",
      "record_type": "CNAME",
      "target": "mcp.brasildesconto.com.br",
      "proxied": true,
      "ttl": 1,
      "scope": "aio:rider:read"
    },
    {
      "environment": "production",
      "hostname": "mcp-admin.brasildesconto.com.br",
      "record_type": "CNAME",
      "target": "mcp.brasildesconto.com.br",
      "proxied": true,
      "ttl": 1,
      "scope": "aio:admin:read"
    }
  ],
  "guardrails": {
    "allow_apex_changes": false,
    "allow_wildcards": false,
    "allow_delete": false,
    "allowed_record_types": [
      "CNAME"
    ],
    "require_proxied": true,
    "require_explicit_zone_confirmation": true,
    "preserve_existing_unmanaged_records": true,
    "gateway_source": "services/aio-mcp-gateway"
  },
  "application": {
    "script": "scripts/configure_cloudflare_mcp_dns.py",
    "token_env_var": "CLOUDFLARE_API_TOKEN",
    "zone_id_env_var": "CLOUDFLARE_ZONE_ID",
    "account_id_source": "config/cloudflare/workspace_profile.json",
    "default_mode": "check",
    "external_requirements": [
      "Cloudflare API token with Zone Read and DNS Write",
      "origin target supplied through the selected target environment variable",
      "OIDC provider, Redis and deployed gateway health before production cutover"
    ]
  }
}
