{
  "$schema": "https://schemas.tokens.studio/latest/tokens.schema.json",
  "color": {
    "background": { "deep": { "$type": "color", "$value": "#040A12" }, "base": { "$type": "color", "$value": "#07111F" } },
    "surface": { "base": { "$type": "color", "$value": "#0C1929" }, "raised": { "$type": "color", "$value": "#112238" }, "soft": { "$type": "color", "$value": "#0E1E31" } },
    "border": { "base": { "$type": "color", "$value": "#21364E" }, "soft": { "$type": "color", "$value": "#172A40" } },
    "text": { "primary": { "$type": "color", "$value": "#F7FBFF" }, "secondary": { "$type": "color", "$value": "#A9B8CA" }, "muted": { "$type": "color", "$value": "#71849A" } },
    "brand": { "primary": { "$type": "color", "$value": "#39D98A" }, "strong": { "$type": "color", "$value": "#1FBE70" } },
    "semantic": { "info": { "$type": "color", "$value": "#4F8CFF" }, "accent": { "$type": "color", "$value": "#9A75FF" }, "warning": { "$type": "color", "$value": "#F4B860" }, "danger": { "$type": "color", "$value": "#FF6B79" } }
  },
  "spacing": {
    "0": { "$type": "dimension", "$value": "0px" }, "1": { "$type": "dimension", "$value": "4px" }, "2": { "$type": "dimension", "$value": "8px" }, "3": { "$type": "dimension", "$value": "12px" }, "4": { "$type": "dimension", "$value": "16px" }, "5": { "$type": "dimension", "$value": "20px" }, "6": { "$type": "dimension", "$value": "24px" }, "8": { "$type": "dimension", "$value": "32px" }, "10": { "$type": "dimension", "$value": "40px" }, "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "10px" }, "medium": { "$type": "dimension", "$value": "15px" }, "large": { "$type": "dimension", "$value": "22px" }, "xlarge": { "$type": "dimension", "$value": "30px" }, "pill": { "$type": "dimension", "$value": "999px" }
  },
  "typography": {
    "fontFamily": { "ui": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] } },
    "display": { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.ui}", "fontSize": "34px", "fontWeight": "700", "lineHeight": "40px", "letterSpacing": "-1.5px" } },
    "heading": { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.ui}", "fontSize": "20px", "fontWeight": "700", "lineHeight": "26px", "letterSpacing": "-0.4px" } },
    "body": { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.ui}", "fontSize": "14px", "fontWeight": "400", "lineHeight": "21px", "letterSpacing": "0px" } },
    "label": { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.ui}", "fontSize": "12px", "fontWeight": "650", "lineHeight": "16px", "letterSpacing": "0px" } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{typography.fontFamily.ui}", "fontSize": "10px", "fontWeight": "500", "lineHeight": "14px", "letterSpacing": "0.2px" } }
  },
  "shadow": {
    "panel": { "$type": "boxShadow", "$value": { "color": "#00000047", "type": "dropShadow", "x": "0px", "y": "18px", "blur": "55px", "spread": "0px" } },
    "overlay": { "$type": "boxShadow", "$value": { "color": "#00000070", "type": "dropShadow", "x": "0px", "y": "24px", "blur": "70px", "spread": "0px" } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" }, "standard": { "$type": "duration", "$value": "170ms" }, "slow": { "$type": "duration", "$value": "260ms" }, "easing": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
  }
}
