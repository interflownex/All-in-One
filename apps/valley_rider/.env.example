# API Hub oficial do ecossistema All in One + Valley
VITE_API_HUB_URL=https://all-in-one-api-hub.web.app

# Token PUBLICO Mapbox, iniciado por pk. e restrito aos dominios autorizados.
# Nunca use token sk. no Vite, no navegador, no APK ou no repositorio.
VITE_MAPBOX_ACCESS_TOKEN=

# SDK web fixado para reprodutibilidade. Atualize somente em PR testada.
VITE_MAPBOX_GL_JS_VERSION=3.25.0

# Estilos oficiais de navegacao. Podem ser substituidos por estilos proprios publicados no Mapbox Studio.
VITE_MAPBOX_STYLE_DAY=mapbox://styles/mapbox/navigation-day-v1
VITE_MAPBOX_STYLE_NIGHT=mapbox://styles/mapbox/navigation-night-v1

# auto escolhe diurno/noturno pelo horario e preferencia do dispositivo.
VITE_MAPBOX_NAVIGATION_MODE=auto

# Token de integridade injetado pelo shell Android/WebView quando exigido.
VITE_PLAY_INTEGRITY_TOKEN=
