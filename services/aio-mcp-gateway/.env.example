# Ambiente local seguro. Nunca copie tokens, senhas ou chaves para este arquivo.
DEPLOYMENT_ENV=development
AUTH_REQUIRED=false
LOG_LEVEL=INFO

# Obrigatórios quando AUTH_REQUIRED=true ou DEPLOYMENT_ENV=production.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
MCP_REQUIRED_SCOPE=aio:mcp:read

# Redis é obrigatório em produção para rate limit distribuído.
REDIS_URL=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576

# Endpoint canônico do recurso protegido.
PROTECTED_RESOURCE_URL=https://mcp.brasildesconto.com.br/mcp

# Origens e hosts autorizados pelo transporte MCP.
MCP_ALLOWED_ORIGINS=https://brasildesconto.com.br,https://mcp.brasildesconto.com.br,https://mcp-staging.brasildesconto.com.br,https://mcp-preview.brasildesconto.com.br,http://localhost:8080,http://127.0.0.1:8080
MCP_ALLOWED_HOSTS=mcp.brasildesconto.com.br,mcp-staging.brasildesconto.com.br,mcp-preview.brasildesconto.com.br,testserver,localhost:*,127.0.0.1:*
