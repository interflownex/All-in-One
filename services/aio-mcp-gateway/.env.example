# Ambiente local seguro. Nunca copie tokens, senhas ou chaves para este arquivo.
DEPLOYMENT_ENV=development
AUTH_REQUIRED=false
LOG_LEVEL=INFO

# Obrigatórios quando AUTH_REQUIRED=true ou DEPLOYMENT_ENV=production.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256

# Redis é obrigatório em produção para rate limit distribuído.
REDIS_URL=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576

# Endpoint canônico e origens permitidas.
PROTECTED_RESOURCE_URL=https://mcp.brasildesconto.com.br
ALLOWED_ORIGINS=https://brasildesconto.com.br,https://mcp.brasildesconto.com.br,https://staging-mcp.brasildesconto.com.br,https://preview-mcp.brasildesconto.com.br
